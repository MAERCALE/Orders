@page "/categories"
<h3>Categorias</h3>
<div>
	<a class=" btn btn-primary" href="/categories/create">Nueva Categoria</a>
</div>
<GenericList MyList="Categories">
	<Body>
		
	<table class="table">

	</table>
	
		<Pagination CurrentPage="currentPage"
		TotalPages="totalPages"
		SelectedPage="SelectedPageAsync" />
		
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Categoria</th>
					<th style="width:140px"></th>
				</tr>	
			</thead>
			<tbody>
				@foreach (var category in Categories!)
				{
					<tr>
						<td> 
							@category.Name
						</td>
						<td>
							<a href="/Categories/edit/@category.Id" class=" btn btn-warning btn-sm">Editar</a>
							<buton @onclick=@(()=>DeleteAsync(category)) class="btn btn-danger btn-sm">Borrar</buton>
						</td>
					</tr>
				}
			</tbody>
		</table>
		
	</Body>

</GenericList>

