@page "/countries"
<h3>Paises</h3>
<div>
	<a class="btn btn-primary " href="/countries/create">Nuevo País</a>
	<div>    </div>
</div>
<GenericList MyList="Countries"> 
	<Body>
		<table class="table">
		</table>

		<Pagination CurrentPage="currentPage"
					TotalPages="totalPages"
					SelectedPage="SelectedPageAsync" />

		<table class="table table-striped">
			<thead>
				<tr>
					<th>País</th>
					<th style="width:210px">Departamentos</th>
					<th style="width:210px"></th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var country in Countries!)
				{
					<tr>
						<td> @country.Name</td>
						<td> @country.StatesNumber </td>
						<td>
							<a href="/countries/edit/@country.Id" class=" btn btn-warning btn-sm">Editar</a>
							<a class="btn btn-info btn-sm" href="/countries/details/@country.Id">Detalles</a>
							<buton class="btn btn-danger btn-sm" @onclick=@(()=>DeleteAsync(country))>Borrar</buton>
						</td>
					</tr>
				}
			</tbody>
		</table>
				
	</Body>

</GenericList>

